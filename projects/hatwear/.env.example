# Public site URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Embroidery requests: where new requests are forwarded (Slack/Zapier/Make/your
# email service webhook). Leave empty to only save them under .data/.
EMBROIDERY_WEBHOOK_URL=

# Protects /admin/requests (the in-app request inbox). Leave empty to disable it.
ADMIN_TOKEN=
