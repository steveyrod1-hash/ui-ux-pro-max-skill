# Public site URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Embroidery requests: where new requests are forwarded (Slack/Zapier/Make/your
# email service webhook). Leave empty to only save them under .data/.
EMBROIDERY_WEBHOOK_URL=

# Protects /admin/requests (the in-app request inbox). Leave empty to disable it.
ADMIN_TOKEN=

# ---------------------------------------------------------------- Clover
# Leave these empty to keep the sample catalog and the demo checkout.
# Where to find each one: README → "Connect Clover".
CLOVER_ENV=sandbox
CLOVER_MERCHANT_ID=
# REST API token (Inventory read + Orders read/write). Server only.
CLOVER_API_TOKEN=
# Ecommerce private key ("Hosted iFrame + API/SDK"). Server only.
CLOVER_ECOMM_PRIVATE_KEY=
# Optional: only items in this Clover category appear on the website.
CLOVER_ONLINE_CATEGORY=Website
# Optional: Clover order type id for website pickup orders.
CLOVER_ORDER_TYPE_ID=
# Optional: set to 1 only if online sales don't lower Clover stock on their own.
CLOVER_DECREMENT_STOCK=

# Public values for the payment form (safe in the browser).
NEXT_PUBLIC_CLOVER_ENV=sandbox
NEXT_PUBLIC_CLOVER_MERCHANT_ID=
NEXT_PUBLIC_CLOVER_PUBLIC_KEY=

# Daily catalog refresh (Vercel → Settings → Git → Deploy Hooks).
VERCEL_DEPLOY_HOOK_URL=
# Set by Vercel for cron requests; any long random string.
CRON_SECRET=
